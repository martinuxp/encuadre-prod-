rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Función para validar si el usuario es administrador
    function isAdmin() {
      return request.auth != null && 
        (request.auth.token.role == 'admin' || 
         request.auth.token.role == 'superadmin' || 
         request.auth.token.role == 'producer');
    }

    // Reglas para archivos del proyecto
    match /projects/{projectId}/{allPaths=**} {
      // Solo admins pueden subir y borrar archivos del proyecto (guiones, PDFs, fotos)
      allow write, delete: if request.auth != null;
      
      // Permitir descargas públicas (lectura) para participantes autorizados
      // (ej. descarga del guión desde el link individual)
      allow read: if true;
    }
    
    // Web pública: imágenes de portada y logos (lectura pública, la web las muestra).
    // Escritura limitada a imágenes de hasta 10 MB.
    match /web/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp|svg.xml)');
      allow delete: if request.auth != null;
    }

    // Reglas generales de marca o assets subidos
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
